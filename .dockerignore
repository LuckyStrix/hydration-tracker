# Keep the build context small and make sure nothing local or private is
# copied into an image layer.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
*.egg-info

# Never build these in. The database belongs in a volume and the environment
# file holds credentials.
.env
data/
backups/
*.db
*.db-wal
*.db-shm

# Not needed at runtime.
tests/
docs/
hass/
README.md
CLAUDE.md
LICENSE
