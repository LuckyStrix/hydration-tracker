# Copy to .env before the first `docker compose up`.

# --- Garmin -----------------------------------------------------------------
# Leave blank to run without Garmin; everything else still works and activities
# can be entered by hand.
#
# GARMIN_EMAIL is the EMAIL ADDRESS the account was registered with, not your
# Garmin display username. A username is refused with a 401 that says nothing
# about why -- it is the single most common cause of one.
#
# No quotes are needed around either value, and surrounding whitespace and one
# matched pair of quotes are trimmed if you add them anyway. If the password
# contains a `#`, quote it: some .env parsers treat an unquoted `#` as the
# start of a comment and silently truncate the value.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# If your Garmin account has multi-factor on, the first login needs a code and
# a background thread has nobody to ask. Run this once after starting:
#   docker compose exec hydration hydration garmin-login
# The cached tokens refresh themselves from then on.

HYDRATION_SYNC_MINUTES=15
HYDRATION_GARMIN_BACKFILL_DAYS=30

# Push logged drinks into Garmin's own hydration log so the watch widget
# agrees. Off by default -- it writes to someone else's system.
HYDRATION_GARMIN_WRITE_BACK=0

# --- Access -----------------------------------------------------------------
# Optional bootstrap password. If set, it is hashed into the database on first
# start. Left blank, the first visit asks you to choose one.
HYDRATION_PASSWORD=

# Set to 1 ONLY if something terminates TLS in front of the app -- for example
# `tailscale serve`. It turns on secure cookies, and on plain HTTP the browser
# would then drop them and sign-in would silently never stick.
HYDRATION_BEHIND_PROXY=0

HYDRATION_SESSION_DAYS=30

# After this many wrong passwords the login starts locking, doubling from 30
# seconds up to a quarter of an hour. The count lives in the database, so
# restarting the container does not clear it.
HYDRATION_LOGIN_FREE_ATTEMPTS=5

# The largest body an ordinary form may carry, and the largest an import may.
# They are separate because an import is a whole health log: a year of drinking
# exports to about a megabyte, and holding it to the form limit meant the
# export could not be read back.
HYDRATION_MAX_BODY_BYTES=262144
HYDRATION_IMPORT_MAX_BODY_BYTES=67108864

# --- Backups ----------------------------------------------------------------
# Taken by the app itself, on a timer, into /backups (bind-mounted to
# ./backups). A backup you have to remember to take is a backup you will not
# have. Set AUTOMATIC=0 to turn it off and take them by hand instead.
HYDRATION_BACKUP_AUTOMATIC=1
HYDRATION_BACKUP_HOURS=24
HYDRATION_BACKUP_KEEP=14

# --- Local ------------------------------------------------------------------
TZ=America/New_York
